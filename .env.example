# ============================================================================
# Artisan — artisan-frontend environment configuration
# ============================================================================
# Copy this file to `.env` (which is git-ignored) and adjust as needed:
#
#     cp .env.example .env
#
# IMPORTANT: Variables consumed by client-side (browser) code MUST start with
# the `NEXT_PUBLIC_` prefix — Next.js inlines them into the client bundle at
# build time. Anything without the prefix is only available in server code
# (API routes, server components, middleware).
#
# The backend is a microservice monorepo (artisan-backend). Every service
# mounts its API under `/api/v1` and each runs on its own port during local
# development — the ports below match the `uvicorn.run(port=...)` value in
# each service's `src/<service>/__init__.py` entrypoint.
# ============================================================================

# --- App -------------------------------------------------------------------
# Public URL of the frontend itself (absolute links, sitemap, OG metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Current environment: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# --- Auth Service (identity & auth) ----------------------------------------
# Routes: POST /auth/signup, POST /auth/signin, POST /auth/refresh,
#         POST /auth/logout, GET /auth/me
# Port defined in: services/auth_service/src/auth_service/__init__.py
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8001/api/v1

# --- Media Service (catalog & media) ---------------------------------------
# Routes: /artworks, /artworks/{id}, /artworks/{id}/media, /profiles,
#         /profiles/{id}, /profiles/{id}/artworks
# Port defined in: services/media_service/src/media_service/__init__.py
NEXT_PUBLIC_MEDIA_API_URL=http://localhost:8002/api/v1

# --- Commerce Service (cart, checkout, orders) ------------------------------
# Routes: /cart, /cart/items, /checkout, /checkout/{session_id},
#         /orders, /orders/{id}, /webhooks/stripe
# Port defined in: services/commerce_service/src/commerce_service/__init__.py
NEXT_PUBLIC_COMMERCE_API_URL=http://localhost:8003/api/v1

# --- AI Discovery Service (search) -----------------------------------------
# Routes: /search, /search/vibe, /search/log, /artworks/{id}/similar
# Port defined in: services/ai_discovery_service/src/ai_discovery_service/__init__.py
NEXT_PUBLIC_AI_DISCOVERY_API_URL=http://localhost:8004/api/v1

# --- Moderation Service (trust & moderation) --------------------------------
# Routes: /artworks/{id}/moderation, /artworks/{id}/signature,
#         /moderation/flags, /moderation/flags/{id}
# Port defined in: services/moderation_service/src/moderation_service/__init__.py
NEXT_PUBLIC_MODERATION_API_URL=http://localhost:8005/api/v1

# --- Personalization Service (feed & interactions) --------------------------
# Routes: /feed, /interactions, /interactions/me
# Port defined in: services/personalization_service/src/personalization_service/__init__.py
NEXT_PUBLIC_PERSONALIZATION_API_URL=http://localhost:8006/api/v1

# --- HTTP client ------------------------------------------------------------
# Default timeout (milliseconds) applied to every request made through
# `lib/api.ts`. Increase if you are debugging slow responses.
NEXT_PUBLIC_API_TIMEOUT_MS=10000
